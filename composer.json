    "autoload": {
        "psr-4": {
            "Andydefer\\FcmNotifications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Andydefer\\FcmNotifications\\Tests\\": "tests/"
        }
